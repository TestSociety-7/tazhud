# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Passcode for /admin. If unset, the demo passcode "tazhud-demo" is used and
# shown on the sign-in page. Always set this before sharing the site.
ADMIN_PASSCODE=

# Secret used to sign the admin session cookie. Use a long random string,
# e.g. `openssl rand -base64 32`. Falls back to a value derived from ADMIN_PASSCODE.
ADMIN_SESSION_SECRET=

# Public URL used for social sharing metadata (optional on Vercel).
NEXT_PUBLIC_SITE_URL=
